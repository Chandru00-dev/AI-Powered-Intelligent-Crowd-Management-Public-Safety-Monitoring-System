# ==========================================================
# AI-Powered Intelligent Crowd Management & Public Safety
# Environment Configuration
# ==========================================================

# Application Settings
APP_NAME="AI-Powered Intelligent Crowd Management and Public Safety Monitoring System"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Security & JWT
# IMPORTANT: Replace SECRET_KEY with a random 32+ char hex in production
SECRET_KEY="crowd-safety-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# PostgreSQL is the primary database. If PostgreSQL credentials fail to connect,
# the application can automatically fall back to SQLite for seamless zero-setup evaluation.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crowd_safety_db"
# Fallback SQLite:
SQLITE_FALLBACK_URL="sqlite:///./crowd_safety.db"

# Default Initial Administrator Account (seeded on first boot)
DEFAULT_ADMIN_EMAIL="admin@crowdsafety.ai"
DEFAULT_ADMIN_PASSWORD="Admin@12345"
DEFAULT_ADMIN_NAME="System Administrator"

# Default Security Operator Account (seeded on first boot)
DEFAULT_OPERATOR_EMAIL="operator@crowdsafety.ai"
DEFAULT_OPERATOR_PASSWORD="Operator@12345"
DEFAULT_OPERATOR_NAME="Control Room Operator"

# Video Streaming Settings
MAX_STREAM_FPS=25
JPEG_QUALITY=75
RTSP_TIMEOUT_MS=5000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000"
